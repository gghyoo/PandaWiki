# Internal subnet prefix used for container-to-container communication.
# Change this only if 169.254.15.x conflicts with your host network.
SUBNET_PREFIX=169.254.15

# PostgreSQL password for the panda-wiki database user
POSTGRES_PASSWORD=change-me-postgres-password

# NATS message queue password
NATS_PASSWORD=change-me-nats-password

# Redis cache password
REDIS_PASSWORD=change-me-redis-password

# JWT secret used for signing authentication tokens (use a long random string)
JWT_SECRET=change-me-jwt-secret

# MinIO / S3-compatible object storage secret key
S3_SECRET_KEY=change-me-s3-secret-key

# Initial admin console login password
ADMIN_PASSWORD=change-me-admin-password

# Host port on which the admin console (nginx) is exposed
ADMIN_PORT=2443
