# ============================================================
# Stage 1: Build — 安装依赖并构建 Next.js 应用
# 构建上下文必须是 web/ 根目录（需要 monorepo 结构）
# ============================================================
FROM node:22-alpine AS builder

RUN apk add --no-cache libc6-compat

WORKDIR /workspace

# 启用 pnpm（版本与 web/package.json 中 packageManager 字段一致）
RUN corepack enable && corepack prepare pnpm@10.12.1 --activate

# 先复制依赖描述文件，充分利用 Docker 层缓存
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# 复制 shared packages（workspace 内部依赖）
COPY packages ./packages

# 复制两个 app（pnpm install 需要感知所有 workspace 成员）
COPY admin ./admin
COPY app ./app

RUN pnpm install --frozen-lockfile

# 只构建 app；Next.js standalone 输出在 app/dist/standalone/
RUN pnpm --filter panda-wiki-app build

# ============================================================
# Stage 2: Runtime — Node.js 服务 Next.js standalone 产物
# ============================================================
FROM node:22-alpine

ENV NODE_ENV=production

RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

WORKDIR /app

# 与原 web/app/Dockerfile 保持一致的文件布局
COPY --chown=nextjs:nodejs --from=builder /workspace/app/public ./app/public
COPY --chown=nextjs:nodejs --from=builder /workspace/app/dist/standalone ./
COPY --chown=nextjs:nodejs --from=builder /workspace/app/dist/static ./app/dist/static

USER nextjs
EXPOSE 3010
ENV PORT=3010
ENV HOSTNAME="0.0.0.0"

CMD ["node", "app/server.js"]
