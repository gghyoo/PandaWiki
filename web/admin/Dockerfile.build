# ============================================================
# Stage 1: Build — 安装依赖并构建 admin 前端
# 构建上下文必须是 web/ 根目录（需要 monorepo 结构）
# ============================================================
FROM node:22-alpine AS builder

RUN apk add --no-cache libc6-compat

WORKDIR /workspace

# 启用 pnpm（版本与 web/package.json 中 packageManager 字段一致）
RUN corepack enable && corepack prepare pnpm@10.12.1 --activate

# 先复制依赖描述文件，充分利用 Docker 层缓存
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# 复制 shared packages（workspace 内部依赖）
COPY packages ./packages

# 复制两个 app（pnpm install 需要感知所有 workspace 成员）
COPY admin ./admin
COPY app ./app

RUN pnpm install --frozen-lockfile

# 只构建 admin
RUN pnpm --filter panda-wiki-admin build

# ============================================================
# Stage 2: Runtime — nginx 服务静态产物
# ============================================================
FROM nginx:alpine

# 将内置占位 SSL 证书存放到独立目录；
# entrypoint 在 bind-mount 目录为空时会将其复制过去。
COPY admin/ssl /docker-ssl-defaults
COPY admin/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh && mkdir -p /etc/nginx/ssl

COPY --from=builder /workspace/admin/dist /opt/frontend/dist
COPY admin/server.conf /etc/nginx/conf.d/server.conf
COPY admin/nginx.conf /etc/nginx/nginx.conf

EXPOSE 8080
ENTRYPOINT ["/docker-entrypoint.sh"]
